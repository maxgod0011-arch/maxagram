# APP_URL: The URL where this applet is hosted (e.g. https://your-site.netlify.app or https://your-project.vercel.app)
APP_URL="http://localhost:3000"

# MAXAGRAM_SESSION_SECRET: Strong random secret (32+ chars) for signing session tokens & device hashes.
# Recommended to set in Netlify Site Configuration -> Environment Variables (or Vercel Project Settings).
MAXAGRAM_SESSION_SECRET=""

# MAXAGRAM_ADMIN_EMAIL: Administrator login email (defaults to admin@maxagram.io).
MAXAGRAM_ADMIN_EMAIL="admin@maxagram.io"

# MAXAGRAM_ADMIN_PASSWORD: Strong administrator password (hashed with scrypt on storage).
MAXAGRAM_ADMIN_PASSWORD=""

# Optional Persistent Storage Override (Upstash Redis / Vercel KV REST):
# Note: On Netlify, built-in Netlify Blobs persistence activates automatically with zero extra config!
# You may optionally connect Upstash Redis if you prefer external Redis storage across platforms.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
