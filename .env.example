# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# MAXAGRAM_SESSION_SECRET: Optional HMAC secret for signing session tokens and device hashes.
# If omitted, a persistent server secret is automatically generated on first run.
MAXAGRAM_SESSION_SECRET=""

# MAXAGRAM_ADMIN_EMAIL: Optional initial administrator email override.
MAXAGRAM_ADMIN_EMAIL="admin@maxagram.io"

# MAXAGRAM_ADMIN_PASSWORD: Optional initial administrator password override (hashed with scrypt on storage).
MAXAGRAM_ADMIN_PASSWORD=""
