# APP_URL: The URL where this applet is hosted (e.g. https://your-project.vercel.app)
APP_URL="http://localhost:3000"

# MAXAGRAM_SESSION_SECRET: Strong random secret (32+ chars) for signing session tokens & device hashes.
# Recommended to set in Vercel Project Settings -> Environment Variables.
MAXAGRAM_SESSION_SECRET=""

# MAXAGRAM_ADMIN_EMAIL: Administrator login email (defaults to admin@maxagram.io).
MAXAGRAM_ADMIN_EMAIL="admin@maxagram.io"

# MAXAGRAM_ADMIN_PASSWORD: Strong administrator password (hashed with scrypt on storage).
MAXAGRAM_ADMIN_PASSWORD=""

# Optional Persistent Storage for Vercel Serverless (Vercel KV / Upstash Redis REST):
# Connect Upstash Redis from Vercel Marketplace -> Storage to automatically populate these.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
